# backend/.env.example

# Local development server
PORT=3001
NODE_ENV=development
DOMAIN_COOKIE=

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000

# Public backend base URL for media links
PUBLIC_API_URL=http://localhost:3001

# JWT secrets for local development only
JWT_ACCESS_SECRET=replace_with_local_access_secret
JWT_REFRESH_SECRET=replace_with_local_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local development database
# Example local MySQL DSN for development
DATABASE_URL="mysql://plantshop:123456@localhost:3306/plantshop_test"

# Test key for local development reCAPTCHA
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
