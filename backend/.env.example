# backend/.env.example

# Local development server
PORT=3001
NODE_ENV=development
DOMAIN_COOKIE=
TRUST_PROXY_HOPS=0

# Frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000

# Public backend base URL for media links
PUBLIC_API_URL=http://localhost:3001

# Generate independent high-entropy secrets for every environment.
JWT_ACCESS_SECRET=replace_me_with_strong_random_secret
JWT_REFRESH_SECRET=replace_me_with_strong_random_secret
REFRESH_TOKEN_DIGEST_SECRET=replace_me_with_another_strong_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local development database
DATABASE_URL="mysql://user:password@localhost:3306/database"

# Use a provider test key locally or a real environment-specific secret.
RECAPTCHA_SECRET_KEY=replace_me

# SMTP mail transport for security emails
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="replace_me"
MAIL_PASSWORD="replace_me"
MAIL_FROM_EMAIL="no-reply@example.com"
MAIL_FROM_NAME="PlantShop"

# Session limits
MAX_REFRESH_SESSIONS_PER_USER=10
