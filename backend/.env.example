# backend/.env.example

# --- Сервер ---
# Порт HTTP API. Локально — 3001.
PORT=3001
# development | production | test
NODE_ENV=development
# Домен для auth-cookies (порожнє значення = без domain; локально лишайте порожнім).
# У продакшні задавайте лише якщо фронт і API на піддоменах одного домену, напр. example.com
DOMAIN_COOKIE=
# Кількість довірених reverse-proxy хопів перед бекендом (nginx = 1). 0 = без проксі.
TRUST_PROXY_HOPS=0

# --- CORS / Origin allowlist ---
# Дозволені origin'и фронтенда (можна кілька через кому, без слеша в кінці).
FRONTEND_URL=http://localhost:3000

# --- Публічний URL API ---
# Базовий URL, за яким браузер бачить бекенд (для побудови URL медіафайлів /uploads/...).
PUBLIC_API_URL=http://localhost:3001

# --- Секрети JWT/сесій ---
# Згенеруйте НЕЗАЛЕЖНІ випадкові секрети >=32 символів для кожного середовища,
# наприклад: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_strong_random_secret
JWT_REFRESH_SECRET=replace_me_with_strong_random_secret
REFRESH_TOKEN_DIGEST_SECRET=replace_me_with_another_strong_random_secret
# Тривалість життя токенів (формати: 15m, 12h, 7d).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- База даних ---
# MySQL 8 connection string. У продакшні — окремий користувач з мінімальними правами.
DATABASE_URL="mysql://user:password@localhost:3306/database"

# --- reCAPTCHA ---
# Секретний ключ reCAPTCHA v2 (пара до NEXT_PUBLIC_RECAPTCHA_SITE_KEY на фронтенді).
RECAPTCHA_SECRET_KEY=replace_me

# --- SMTP для security-листів (верифікація, скидання пароля, коди входу) і контакт-форми ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# true лише для SMTPS (порт 465); для STARTTLS на 587 — false.
MAIL_SECURE=false
MAIL_USER="replace_me"
MAIL_PASSWORD="replace_me"
MAIL_FROM_EMAIL="no-reply@example.com"
MAIL_FROM_NAME="PlantShop"

# --- Ліміти сесій ---
# Максимум активних refresh-сесій на користувача (за замовчуванням 10).
MAX_REFRESH_SESSIONS_PER_USER=10

# --- Опціонально ---
# Кількість раундів bcrypt для хешування паролів (за замовчуванням 12).
# BCRYPT_SALT_ROUNDS=12
