# frontend/.env.example

# Базовий URL backend API для клієнтських запитів із браузера.
# У продакшні — публічний HTTPS-домен API, наприклад https://api.example.com
# Цей самий origin автоматично потрапляє в CSP (connect-src/img-src) —
# міняти адресу треба ЛИШЕ тут, у next.config.ts нічого вписувати не потрібно.
NEXT_PUBLIC_API_URL=http://localhost:3001

# (Опційно) Додаткові origin бекенда, які треба дозволити в CSP, через кому.
# Корисно, коли сайт відкривають і через localhost, і через LAN-IP водночас,
# напр.: NEXT_PUBLIC_EXTRA_API_ORIGINS=http://192.168.1.8:3001
# У dev localhost-варіанти вже дозволені автоматично — це лише для нестандартних хостів.
# NEXT_PUBLIC_EXTRA_API_ORIGINS=

# Базовий URL backend API для SSR/server-side fetch у Next.js.
# Зазвичай збігається з NEXT_PUBLIC_API_URL; на сервері може бути внутрішня адреса (http://127.0.0.1:3001)
INTERNAL_API_URL=http://localhost:3001

# Публічний site key reCAPTCHA v2 для відповідного середовища.
# Для локальної розробки можна використати тестовий ключ Google.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace_me

# Канонічний публічний URL сайту (origin без трейлінг-слеша).
# Використовується для metadataBase, canonical, sitemap.xml, robots.txt і JSON-LD.
# У продакшні — реальний HTTPS-домен, наприклад https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
