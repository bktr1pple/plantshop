# frontend/.env.example

# Локальний backend API для клієнтських запитів
NEXT_PUBLIC_API_URL=http://localhost:3001

# Локальний backend API для SSR/server-side fetch у Next.js
INTERNAL_API_URL=http://localhost:3001

# Клієнтські налаштування
NEXT_PUBLIC_PWA_NAME="Plant Shop"
NEXT_PUBLIC_PWA_THEME_COLOR="#ffffff"
NEXT_PUBLIC_ENVIRONMENT=development

# Публічний site key reCAPTCHA для відповідного середовища
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=replace_me
